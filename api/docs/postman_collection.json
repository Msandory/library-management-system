{
  "info": { "name": "Library Management API", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json" },
  "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
  "variable": [{ "key": "baseUrl", "value": "http://localhost:3000" }, { "key": "token", "value": "" }],
  "item": [
    { "name": "Auth", "item": [
      { "name": "Register", "request": { "method": "POST", "auth": { "type": "noauth" }, "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/register", "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"password123\",\n  \"name\": \"Reader\"\n}" } } },
      { "name": "Login", "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.collectionVariables.set('token', pm.response.json().access_token);"] } }], "request": { "method": "POST", "auth": { "type": "noauth" }, "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/auth/login", "body": { "mode": "raw", "raw": "{\n  \"email\": \"reader@example.com\",\n  \"password\": \"password123\"\n}" } } },
      { "name": "Profile", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/users/profile" } }
    ] },
    { "name": "Genres", "item": [
      { "name": "Create genre", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/genres", "body": { "mode": "raw", "raw": "{\n  \"name\": \"Science Fiction\",\n  \"description\": \"Speculative fiction\"\n}" } } },
      { "name": "List genres", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/genres" } },
      { "name": "Get genre", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/genres/1" } },
      { "name": "Update genre", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/genres/1", "body": { "mode": "raw", "raw": "{\n  \"description\": \"Updated description\"\n}" } } },
      { "name": "Delete genre", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/genres/1" } }
    ] },
    { "name": "Books", "item": [
      { "name": "List books (filter, search, paginate)", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books?genreId=1&search=dune&page=1&limit=10" } },
      { "name": "Get book", "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/books/1" } },
      { "name": "Create book (LIBRARIAN)", "request": { "method": "POST", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/books", "body": { "mode": "raw", "raw": "{\n  \"title\": \"Dune\",\n  \"author\": \"Frank Herbert\",\n  \"isbn\": \"9780441013593\",\n  \"totalCopies\": 3,\n  \"genreId\": 1\n}" } } },
      { "name": "Update book (LIBRARIAN)", "request": { "method": "PATCH", "header": [{ "key": "Content-Type", "value": "application/json" }], "url": "{{baseUrl}}/books/1", "body": { "mode": "raw", "raw": "{\n  \"totalCopies\": 5\n}" } } },
      { "name": "Delete book (LIBRARIAN)", "request": { "method": "DELETE", "header": [], "url": "{{baseUrl}}/books/1" } }
    ] }
  ]
}